<?xml version="1.0" encoding="utf-8"?>
<!-- CUSTOM: Android 12+ system splash in the sky blue of the animated splash, white Zajel bird (new file) -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/background_color</item>
        <!-- white bird instead of the (blue-on-white) launcher icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
